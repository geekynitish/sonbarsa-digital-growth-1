# Hashed Astro assets (JS, CSS, SVGs) - 1 Year Immutable (Max Cloudflare TTL)
/_astro/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# Static images & brand assets - 1 Year Immutable (Max Cloudflare TTL)
/img/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/android-chrome-*.png
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/favicon*.png
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/site.webmanifest
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# Static HTML Pages - 24 Hr Browser Cache, 1 Month Cloudflare Edge Cache with background revalidation
/*
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800
