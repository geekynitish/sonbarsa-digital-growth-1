---
import Layout from "@/layouts/Layout.astro";
import { SiteHeader } from "@/components/site/SiteHeader";
import { GoogleAnalytics } from "@/components/GoogleAnalytics";
import { Footer } from "@/components/layout/Footer";
import { HeroSection } from "@/components/home/HeroSection";
import { ServicesSection } from "@/components/home/ServicesSection";
import { ProductsSection } from "@/components/home/ProductsSection";
import { AboutSection } from "@/components/home/AboutSection";
import { WhyUsSection } from "@/components/home/WhyUsSection";
import { TestimonialsSection } from "@/components/home/TestimonialsSection";
import { TeamSection } from "@/components/home/TeamSection";
import { ClientsSection } from "@/components/home/ClientsSection";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "SonBarsa — Digital Growth & Software Development Company",
  url: "https://sonbarsa.com/",
  description: "SonBarsa is a premier digital growth and custom software development company delivering enterprise FinTech tools, web & mobile applications, SEO, digital marketing, and AI solutions.",
  isPartOf: { "@id": "https://sonbarsa.com/#website" },
  about: [
    "Digital Growth", "Custom Software Development", "FinTech Software", "Loan Management Tool",
    "Web Development", "Mobile App Development", "SEO", "Digital Marketing",
    "Artificial Intelligence", "AWS Cloud", "Predictive Analytics",
  ],
};
---

<Layout
  title="SonBarsa — Digital Growth &amp; Custom Software Solutions | Web, FinTech, SEO &amp; AI"
  description="SonBarsa is a premier digital growth and custom software development company building enterprise FinTech tools, web &amp; mobile apps, SEO, digital marketing, and AI solutions since 2008."
  keywords="SonBarsa, Sonbarsa Finance, digital growth company, custom software development, web development company, mobile app development, SEO services, digital marketing, FinTech software, loan management tool, artificial intelligence, cloud solutions"
  canonical="https://sonbarsa.com/"
  ogTitle="SonBarsa — Digital Growth &amp; Custom Software Solutions"
  ogDescription="Enterprise FinTech tools, custom web &amp; mobile apps, SEO, digital marketing, and smart AI solutions. Trusted by enterprises since 2008."
  ogImage="https://img.sonbarsa.com/img/og-preview.png"
  jsonLd={jsonLd}
>
  <SiteHeader client:load pathname={Astro.url.pathname} />
  <GoogleAnalytics client:idle />

  <main>
    <HeroSection client:load />
    <ServicesSection />
    <ProductsSection client:load />
    <AboutSection />
    <WhyUsSection />
    <TestimonialsSection />
    <TeamSection />
    <ClientsSection />
  </main>

  <Footer />
</Layout>
